DATABASE_URL=sqlite:///data/private/app.sqlite3
SECRET_KEY=replace-with-a-long-random-secret
UPLOAD_MAX_MIB=12
CORS_ORIGINS=http://localhost:5173

# Optional: DeepSeek only proposes categories; every result still needs review.
DEEPSEEK_CLASSIFICATION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional public merchant lookup. Only the sanitized merchant short name is sent.
# DeepSeek's normal API does not include web search, so this uses Brave Search as
# an external evidence provider before DeepSeek produces a candidate.
MERCHANT_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
MERCHANT_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
